import math
import pygame
import random
import sys

# --- CONFIGURATION ---
WIDTH, HEIGHT = 600, 600
BASE_RADIUS = 130
COLOR_WAVE = (245, 245, 248)  # Pristine Voice UI white
COLOR_BG = (10, 10, 12)       # Dark background

pygame.init()
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Smooth Voice UI - Organic Idle Waves")
clock = pygame.time.Clock()

time_counter = 0.0

# Dynamic target variables (simulating talking audio)
target_v = target_b = target_m = target_t = 0.0
# Smoothed running variables (interpolation state)
v = b = m = t = 0.0

running = True
while running:
    clock.tick(60)
    screen.fill(COLOR_BG)
    
    # --- SIMULATE SPEECH INTERMITTENTLY ---
    # Cycle between 3 seconds of active talking and 3 seconds of perfect idle
    current_ticks = pygame.time.get_ticks()
    if (current_ticks // 3000) % 2 == 0:
        if random.random() < 0.05:
            target_v = random.uniform(0.3, 1.4)
            target_b = random.uniform(0.2, 1.8)
            target_m = random.uniform(0.2, 1.8)
            target_t = random.uniform(0.1, 1.2)
    else:
        # Go completely silent to show off the refined idle state
        target_v = target_b = target_m = target_t = 0.0

    # TEMPORAL SMOOTHING: Glides variables smoothly
    smoothing_factor = 0.12
    v += (target_v - v) * smoothing_factor
    b += (target_b - b) * smoothing_factor
    m += (target_m - m) * smoothing_factor
    t += (target_t - t) * smoothing_factor

    # Advance time (flows calmly at baseline, speeds up slightly when loud)
    time_counter += 0.03 + (v * 0.04)

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    center_x, center_y = WIDTH // 2, HEIGHT // 2
    num_points = 240  # Ultra-high density loop
    
    raw_radii = []
    for i in range(num_points):
        angle = (i / num_points) * math.pi * 2
        
        # 1. ORGANIC IDLE WAVE ANIMATION:
        # Blends two different frequencies so the bumps naturally have varying heights
        # Base tight ripples (amplitude 3.0) + Slow broad shifts (amplitude 1.5)
        # Keeps maximum idle movement constrained under 4.5 pixels to stay circular
        wave_1 = math.sin(angle * 6 + time_counter * 1.5) * 3.0
        wave_2 = math.cos(angle * 3 - time_counter * 0.8) * 1.5
        idle_ripple = wave_1 + wave_2
        
        # 2. TALKING MORPHS (only active when sound variables > 0)
        bass_influence = math.sin(angle * 2 - time_counter * 1.2) * (b * 24)
        mids_influence = math.cos(angle * 4 + time_counter * 1.5) * (m * 16)
        treble_influence = math.sin(angle * 7 + time_counter * 2.2) * (t * 10)
        global_expansion = v * 30
        
        # Combine parameters to get total shape radius
        r = BASE_RADIUS + idle_ripple + global_expansion + bass_influence + mids_influence + treble_influence
        raw_radii.append(r)

    # SPATIAL SMOOTHING: Smooths out sharp edge transitions
    smoothed_radii = []
    window_size = 7
    for i in range(num_points):
        total = 0
        for w in range(-window_size // 2, window_size // 2 + 1):
            total += raw_radii[(i + w) % num_points]
        smoothed_radii.append(total / window_size)

    # Convert to standard coordinate points
    points = []
    for i in range(num_points):
        angle = (i / num_points) * math.pi * 2
        x = center_x + math.cos(angle) * smoothed_radii[i]
        y = center_y + math.sin(angle) * smoothed_radii[i]
        points.append((x, y))

    # Safe render fallback block
    if len(points) > 2:
        pygame.draw.polygon(screen, COLOR_WAVE, points)
        pygame.draw.lines(screen, COLOR_WAVE, True, points, width=2)
    
    pygame.display.flip()

pygame.quit()
sys.exit()
