# TAKAI configuration
# -----------------------------------------------------------------------
# Copy this file to `.env` and edit as needed. Every value below is
# optional -- the defaults shown are what TAKAI uses if you omit them.
#
#   Windows : copy .env.example .env
#   bash    : cp .env.example .env
# -----------------------------------------------------------------------


# === PROVIDER ==========================================================
# Which LLM backend to use: ollama | gemini | anthropic
TAKAI_PROVIDER=ollama

# Path to the system prompt, relative to the repo root.
TAKAI_SYSTEM_PROMPT=TAKAI_SYSTEM.md

TAKAI_TEMPERATURE=0.5
TAKAI_MAX_TOKENS=1024

# Conversation memory: how many user+assistant turn PAIRS to keep.
TAKAI_HISTORY_TURNS=8


# === OLLAMA (default: local, free, offline, no key) ====================
OLLAMA_URL=http://localhost:11434/api/chat

# Must match a model you have pulled (`ollama list`).
# Good multilingual choices, largest first:
#   qwen3:8b    ~5 GB   strong Indonesian, recommended
#   qwen3:4b    ~2.6 GB lighter, for 8 GB RAM machines
#   gemma3:12b  ~8 GB   very good, needs more RAM
OLLAMA_MODEL=qwen3:8b

# Raise this if a large model is slow to load on first use.
OLLAMA_TIMEOUT=120


# === GEMINI (optional) =================================================
# Requires: pip install google-genai
# Key from https://aistudio.google.com/apikey
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash


# === ANTHROPIC (optional) ==============================================
# Requires: pip install anthropic
# Key from https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5


# === INTERACTION MODE ==================================================
# text  -> type to TAKAI
# voice -> speak to TAKAI via microphone
TAKAI_MODE=text


# === SPEECH ============================================================
# Recognition language. Keep this as id-ID -- leaving it unset makes the
# recogniser default to en-US and mangle Indonesian speech.
TAKAI_LANGUAGE=id-ID

# Spoken output on/off.
TAKAI_TTS=true

# Indonesian neural voices: id-ID-ArdiNeural (male), id-ID-GadisNeural (female)
# List them with: python -m audio.tts --voices
TAKAI_TTS_VOICE=id-ID-ArdiNeural
TAKAI_TTS_RATE=+0%
TAKAI_TTS_PITCH=+0Hz


# === MICROPHONE ========================================================
# Leave TAKAI_STT_DEVICE blank to use the system default input.
# List devices with: python -m audio.stt --devices
TAKAI_STT_DEVICE=

TAKAI_STT_SAMPLE_RATE=16000

# Seconds of silence that marks the end of your sentence.
TAKAI_STT_SILENCE_SECONDS=1.0

# Give up listening if you never start speaking.
TAKAI_STT_START_TIMEOUT=8.0

# Maximum length of a single utterance.
TAKAI_STT_MAX_SECONDS=20.0

# Sensitivity: multiplier over the measured room noise that counts as
# speech. Raise it in a noisy room, lower it if TAKAI misses quiet speech.
TAKAI_STT_THRESHOLD_FACTOR=3.0
